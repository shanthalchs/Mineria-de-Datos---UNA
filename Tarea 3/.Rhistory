pruebaUscrime <- uscrimeCuantitativas[-azar2,]
matriz.corrA <- cor(aprendizajeUscrime)
matriz.corrP <- cor(pruebaUscrime)
corrplot(matriz.corrA)
corrplot(matriz.corrP)
uscrime <- read_csv("Datos_EjemplosClase_Tarea/uscrime.csv")
uscrimeCuantitativas <- dummy.data.frame(uscrime, sep = ";")
azar2 <- sample(1:nrow(uscrime), nrow(uscrime)*0.67)
aprendizajeUscrime <- uscrimeCuantitativas[azar2,]
pruebaUscrime <- uscrimeCuantitativas[-azar2,]
matriz.corrA <- cor(aprendizajeUscrime)
matriz.corrP <- cor(pruebaUscrime)
corrplot(matriz.corrA)
corrplot(matriz.corrP)
View(uscrimeCuantitativas)
modelo.predictivo <- lm(ViolentCrimesPerPop~ . , data = aprendizajeUscrime)
modelo.predictivo
numero.predictoras <- dim(uscrimeCuantitativas)[2] - 1
#Usando los datos del 85%
prediccion <- predict(modelo.predictivo, pruebaUscrime)
pre.lm <- indices.precision(pruebaUscrime$ViolentCrimesPerPop, prediccion, numero.predictoras)
pre.lm
